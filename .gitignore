Output/
.gocache/
.vscode/
cmd/
*.exe
# Machine-local paths. Both files are GENERATED by tools/init_machine.py, which
# also keeps the first version it ever replaced as a .bak. The committed record
# of what belongs in them is the SETTINGS table in that script -- there is no
# template to copy, because a template would be a second place to keep the same
# list and the two would drift.
#
# Both languages are listed while M7 (the PowerShell -> Python rewrite) is in
# progress; machine.ps1 stops being generated at step 6.
TestTool/config/machine.ps1
TestTool/config/machine.py
TestTool/config/*.bak
__pycache__/
*.pyc

# .claude/settings.json IS committed -- it is the shared, machine-independent
# permission allowlist. Only the local override is private. Listing it here
# rather than relying on a global gitignore, which a new machine will not have.
# The trailing * also covers the .bak that init_machine.py keeps of the
# first version it ever replaced.
.claude/settings.local.json*
